## @file
#  QEMU virt memory map for the sunfish test profile.
#
#  The SM7150 map (Silicon/Qualcomm/sm7150/Library/PlatformMemoryMapLib) only
#  describes the hardware, so it has no window for the qemu-system-aarch64 -M
#  virt GIC/console.  This library reuses that table and appends them, so the
#  sunfishqemu profile can boot under QEMU without touching the device map.
#
#  Copyright (c) 2026, sunfish port contributors.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = QemuVirtMemoryMapLib
  FILE_GUID                      = 2f8a5c31-6b4d-4e27-9c15-7d3a8e6b1f42
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = PlatformMemoryMapLib

[Sources]
  QemuVirtMemoryMapLib.c

[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  Silicon/Qualcomm/QcomPkg/QcomPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
